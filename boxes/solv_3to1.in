source leaprc.gaff2
source leaprc.water.tip3p
addAtomTypes {
  { "c5" "C" "sp3" }
  { "c6" "C" "sp3" }
}
loadamberparams monomer.frcmod
loadamberparams pyrene.frcmod
MON = loadmol2 res_MON.mol2
MNF = loadmol2 res_MNF.mol2
MNL = loadmol2 res_MNL.mol2
CPH = loadmol2 res_CPH.mol2
CPT = loadmol2 res_CPT.mol2
PYR = loadmol2 pyrene_gaff2.mol2
sys = loadpdb sys_3to1.pdb
check sys
charge sys
solvatebox sys TIP3PBOX 12.0
saveamberparm sys sys_3to1.prmtop sys_3to1.inpcrd
quit
