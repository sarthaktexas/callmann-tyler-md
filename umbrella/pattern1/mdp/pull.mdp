; Steered pull: pyrene COM away from chain-core COM along the distance coordinate.
; Produces starting configurations for umbrella windows. Box fixed in size by pcoupl=no
integrator = md
dt = 0.002
nsteps = 1000000          ; 2 ns
constraints = h-bonds
constraint-algorithm = lincs
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
pcoupl = no
continuation = yes
pbc = xyz
nstxout-compressed = 1000   ; 2 ps, full system (needed to seed windows)
pull = yes
pull-ncoords = 1
pull-ngroups = 2
pull-group1-name = CORE
pull-group2-name = PYRENE
pull-group1-pbcatom = 369   ; core atom closest to the middle of the CORE group (max 1.27 nm to any other core atom at start)
pull-coord1-type = umbrella
pull-coord1-geometry = distance
pull-coord1-groups = 1 2
pull-coord1-dim = Y Y Y
pull-coord1-start = yes
pull-coord1-rate = 0.0012   ; nm/ps -> 2.4 nm in 2 ns
pull-coord1-k = 1000
pull-nstxout = 1000
pull-nstfout = 1000
