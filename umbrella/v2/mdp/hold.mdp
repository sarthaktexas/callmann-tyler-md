; 5 ns held at 0.55 nm to relax the bound complex before pulling out. Fixed box.
integrator = md
dt = 0.002
constraints = h-bonds
constraint-algorithm = lincs
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
pbc = xyz
nsteps = 2500000
pcoupl = no
continuation = yes
nstxout-compressed = 10000
nstenergy = 10000
pull = yes
pull-ncoords = 1
pull-ngroups = 2
pull-group1-name = CORE
pull-group2-name = PYRENE
pull-group1-pbcatom = 369   ; core atom closest to the middle of the CORE group
pull-pbc-ref-prev-step-com = yes   ; chain starts extended, so the CORE group can span > half the pull box; reference = previous-step COM
pull-coord1-type = umbrella
pull-coord1-geometry = distance
pull-coord1-groups = 1 2
pull-coord1-dim = Y Y Y
pull-coord1-k = 1000
pull-coord1-start = no
pull-coord1-init = 0.55
pull-coord1-rate = 0
pull-nstxout = 500
pull-nstfout = 500
