source leaprc.gaff2
addAtomTypes {
  { "c5" "C" "sp3" }
  { "c6" "C" "sp3" }
}
loadamberparams ../../params/gaff2/monomer.frcmod
MON = loadmol2 ../../params/gaff2/res_MON.mol2
MNF = loadmol2 ../../params/gaff2/res_MNF.mol2
MNL = loadmol2 ../../params/gaff2/res_MNL.mol2
CPH = loadmol2 ../../params/gaff2/res_CPH.mol2
CPT = loadmol2 ../../params/gaff2/res_CPT.mol2
chain = loadpdb chain_s1.pdb
check chain
charge chain
saveamberparm chain chain_s1.prmtop chain_s1.inpcrd
quit
